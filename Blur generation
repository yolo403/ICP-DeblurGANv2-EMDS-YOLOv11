import cv2
import numpy as np
import albumentations as A
import os
import random
from tqdm import tqdm


class CitrusBlurProcessor:
    def __init__(self):
        # 初始化模糊方法 (保留了你原本的重度模糊参数，如需轻度模糊请调小这里的值)
        self.motion_blur = A.MotionBlur(blur_limit=(70, 101), p=1.0)

    def apply_extreme_motion_blur(self, image):
        return self.motion_blur(image=image)["image"]

    def apply_heavy_custom_motion(self, image):
        size = random.randint(60, 90)
        angle = random.randint(0, 180)
        kernel = np.zeros((size, size))
        kernel[size // 2, :] = np.ones(size)
        kernel = kernel / size
        M = cv2.getRotationMatrix2D((size / 2 - 0.5, size / 2 - 0.5), angle, 1)
        kernel = cv2.warpAffine(kernel, M, (size, size))
        return cv2.filter2D(image, -1, kernel)

    def apply_extreme_gaussian(self, image):
        ksize = random.choice([81, 91, 101])
        sigma = random.uniform(8.0, 12.0)
        ksize = ksize + 1 if ksize % 2 == 0 else ksize
        return cv2.GaussianBlur(image, (ksize, ksize), sigma)

    def apply_heavy_defocus(self, image):
        size = random.randint(70, 80)
        kernel = np.zeros((size, size))
        cv2.circle(kernel, (size // 2, size // 2), size // 2, 1, -1)
        kernel = kernel / np.sum(kernel)
        return cv2.filter2D(image, -1, kernel)

    def apply_combined_extreme_blur(self, image):
        motion_blurred = self.apply_heavy_custom_motion(image)
        return self.apply_extreme_gaussian(motion_blurred)

    def process_single_image(self, image_path, output_dir):
        """处理单张图像，严格保持原文件名"""
        image = cv2.imread(image_path)
        if image is None:
            print(f"警告: 无法读取图像 {image_path}")
            return False

        blur_methods = [
            self.apply_extreme_motion_blur,
            self.apply_combined_extreme_blur,
            self.apply_heavy_custom_motion,
            self.apply_extreme_gaussian,
            self.apply_heavy_defocus
        ]

        blur_func = random.choice(blur_methods)
        try:
            blurred_image = blur_func(image)

            # 保持原文件名保存
            base_name = os.path.basename(image_path)
            output_img_path = os.path.join(output_dir, base_name)
            cv2.imwrite(output_img_path, blurred_image)
            return True

        except Exception as e:
            print(f"处理 {image_path} 时出错: {str(e)}")
            return False

    def batch_process(self, input_dir, output_dir):
        """批量处理目录中的所有图像"""
        if not os.path.exists(output_dir):
            os.makedirs(output_dir)

        image_files = [f for f in os.listdir(input_dir)
                       if f.lower().endswith(('.png', '.jpg', '.jpeg'))]

        print(f"开始处理 {len(image_files)} 张图像（保持原文件名）...")
        success_count = 0

        for img_file in tqdm(image_files, desc="处理进度"):
            img_path = os.path.join(input_dir, img_file)
            if self.process_single_image(img_path, output_dir):
                success_count += 1

        print(f"处理完成！成功生成 {success_count}/{len(image_files)} 张图像。")
        print(f"结果保存在: {output_dir}")


if __name__ == "__main__":
    blur_processor = CitrusBlurProcessor()

    # 设置路径
    INPUT_DIR = r"D:\project\Citrus_data\yolo_data\images\train"
    OUTPUT_DIR = r"D:\project\Citrus_data\yolo_data\images\train_blur"

    # 批量处理模式
    blur_processor.batch_process(INPUT_DIR, OUTPUT_DIR)
